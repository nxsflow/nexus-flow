# AWS profile for this project (IAM Identity Center / SSO).
# Run `aws sso login` once to authenticate the shared `nxsflow` session.
export AWS_PROFILE=manufaktio-staging

# The NAME of the nexus-flow service instance that belongs to this checkout (nxf 6j6v.gd9p): its own
# launchd agent, its own ~/.nexusflow-dev, and therefore its own registry, lock, heartbeat and log.
#
# It NAMES, it does not SWITCH (nxf 6j6v.cvpy). Which instance a process belongs to is decided by
# the binary that is running: a binary out of target/{debug,release} is a development instance and
# this variable says which one; the INSTALLED nxs/nxf/nxm/nxc on your PATH are the machine's own
# service and this variable has no vote over them, even here. So install this checkout's service by
# running the build itself:
#
#     cargo build && ./target/debug/nxs sync daemon install
#
# which is also what points that instance's alias at the binary you built — the half that never
# worked while the directory decided.
export NXS_SERVICE_INSTANCE=nexus-flow-dev
