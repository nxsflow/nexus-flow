                <mxCell id="sync" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5FFE6;strokeColor=#84CC16;strokeWidth=2;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;fontColor=#1C1C1C;fontSize=13;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" value="&lt;b&gt;Sync (nxs) — extended for nxc&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;ops + run events, status, notifications · ordered and gap-free · signed commissions · target machine, exactly-once on wake · machine liveness and health · opt-in evidence&lt;/font&gt;" vertex="1">
                    <mxGeometry height="120" width="350" x="800" y="780" as="geometry"/>
