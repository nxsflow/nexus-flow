                <mxCell id="inbox" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5FFE6;strokeColor=#84CC16;strokeWidth=2;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;fontColor=#1C1C1C;fontSize=13;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" value="&lt;b&gt;Event inbox&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;append-only · idempotency keys · commissions, replies, notes, facts, decisions · ordered per run and per sender&lt;/font&gt;" vertex="1">
                    <mxGeometry height="100" width="330" x="60" y="300" as="geometry"/>
                </mxCell>
                <mxCell id="engine" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5FFE6;strokeColor=#84CC16;strokeWidth=2;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;fontColor=#1C1C1C;fontSize=13;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" value="&lt;b&gt;Run engine — one state machine per run&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;pure reducer over the run&#39;s events · timers as data · human gates · failure classes · inbox routing via the entry persona · side threads · coalesced triggers · steppable, host-agnostic&lt;/font&gt;" vertex="1">
                    <mxGeometry height="130" width="330" x="430" y="290" as="geometry"/>
                </mxCell>
                <mxCell id="status" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5FFE6;strokeColor=#84CC16;strokeWidth=2;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;fontColor=#1C1C1C;fontSize=13;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" value="&lt;b&gt;Status engine&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;read model · value-free notifications (run, seq) · closed reason codes · finished runs kept · &#39;needs a person&#39; events&lt;/font&gt;" vertex="1">
                    <mxGeometry height="100" width="350" x="800" y="300" as="geometry"/>
                </mxCell>
                <mxCell id="store" parent="1" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D4D4CF;align=center;spacingLeft=14;spacingRight=14;verticalAlign=middle;fontColor=#1C1C1C;fontSize=13;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" value="&lt;b&gt;Coordination store&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;own SQLite file · single writer · compare-and-set · per-run sequence · compaction&lt;/font&gt;" vertex="1">
                    <mxGeometry height="100" width="330" x="430" y="470" as="geometry"/>
                </mxCell>
                <mxCell id="sched" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5FFE6;strokeColor=#84CC16;strokeWidth=2;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;fontColor=#1C1C1C;fontSize=13;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" value="&lt;b&gt;Scheduler&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;machine-wide compute budget · applies the priority policy (no judgement) · visible queue · waiting steps give compute back&lt;/font&gt;" vertex="1">
                    <mxGeometry height="100" width="330" x="60" y="470" as="geometry"/>
                </mxCell>
                <mxCell id="mon" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D4D4CF;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;fontColor=#1C1C1C;fontSize=13;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" value="&lt;b&gt;Resource monitor&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;heavy jobs per process tree (cargo, Playwright) · CPU, memory, free disk, load&lt;/font&gt;" vertex="1">
                    <mxGeometry height="80" width="330" x="60" y="610" as="geometry"/>
                </mxCell>
                <mxCell id="wcm" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D4D4CF;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;fontColor=#1C1C1C;fontSize=13;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" value="&lt;b&gt;Working-copy manager&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;worktree per run · shared build cache · verified hand-over (branch, commit, clean) · external leases · nxf/nxm/nxc resolve to the main workspace&lt;/font&gt;" vertex="1">
                    <mxGeometry height="110" width="350" x="800" y="470" as="geometry"/>
                </mxCell>
                <mxCell id="runtime" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5FFE6;strokeColor=#84CC16;strokeWidth=2;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;fontColor=#1C1C1C;fontSize=13;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" value="&lt;b&gt;Session runtime&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;start spec in, facts out (heartbeat, replied, ended, usage, refusals) · decides nothing&lt;br&gt;adapters: Claude Agent SDK · Codex · Gemini CLI · Kiro CLI · local models&lt;/font&gt;" vertex="1">
