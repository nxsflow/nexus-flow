<mxfile host="nxc-target"><diagram id="nxc-target" name="nxc — target architecture"><mxGraphModel dx="1800" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1830" pageHeight="1120" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="nxc — target architecture (rebuild, epic 6j6v.2vtw)" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#1C1C1C;fontFamily=Merriweather;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%3A700%2C900;" parent="1" vertex="1"><mxGeometry x="40" y="30" width="1300" height="40" as="geometry"/></mxCell><mxCell id="sub" value="One owner per run · events in · contracts first. Green: the core every host runs. Blue: other products and services. Dashed arrows: across machines through the relay." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#6B6B6B;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1"><mxGeometry x="40" y="70" width="1500" height="24" as="geometry"/></mxCell><mxCell id="g_dev" value="Developer machine (e.g. MacBook) — nxs service, developer-machine profile" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9A9A94;dashed=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontColor=#1C1C1C;fontSize=16;fontStyle=1;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1"><mxGeometry x="30" y="110" width="1150" height="990" as="geometry"/></mxCell><mxCell id="surf" value="&lt;b&gt;Surfaces&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;nxc CLI (three distinct actions, nxc watch), agents' Bash, Engine API — append events, read status; never decide&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D4D4CF;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;fontColor=#1C1C1C;fontSize=13;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1"><mxGeometry x="60" y="160" width="330" height="90" as="geometry"/></mxCell><mxCell id="decl" value="&lt;b&gt;Declarations&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;personas, channels, workflows as data · permissions · gate rules · context spec · who may call whom · trust confirmation&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D4D4CF;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;fontColor=#1C1C1C;fontSize=13;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1"><mxGeometry x="430" y="160" width="330" height="90" as="geometry"/></mxCell><mxCell id="ctx" value="&lt;b&gt;Context assembler&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;standing context: ticket (nxf), rules (nxm), callable personas (nxc) · run context: verdicts, answers, status · built at session start, cached per run&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D4D4CF;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;fontColor=#1C1C1C;fontSize=13;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1"><mxGeometry x="800" y="160" width="350" height="90" as="geometry"/></mxCell><mxCell id="inbox" value="&lt;b&gt;Event inbox&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;append-only · idempotency keys · commissions, replies, notes, facts, decisions · ordered per run and per sender&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5FFE6;strokeColor=#84CC16;strokeWidth=2;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;fontColor=#1C1C1C;fontSize=13;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1"><mxGeometry x="60" y="300" width="330" height="100" as="geometry"/></mxCell><mxCell id="engine" value="&lt;b&gt;Run engine — one state machine per run&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;pure reducer over the run's events · timers as data · human gates · failure classes · inbox routing via the entry persona · side threads · coalesced triggers · steppable, host-agnostic&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5FFE6;strokeColor=#84CC16;strokeWidth=2;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;fontColor=#1C1C1C;fontSize=13;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1"><mxGeometry x="430" y="290" width="330" height="130" as="geometry"/></mxCell><mxCell id="status" value="&lt;b&gt;Status engine&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;read model · value-free notifications (run, seq) · closed reason codes · finished runs kept · 'needs a person' events&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5FFE6;strokeColor=#84CC16;strokeWidth=2;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;fontColor=#1C1C1C;fontSize=13;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1"><mxGeometry x="800" y="300" width="350" height="100" as="geometry"/></mxCell><mxCell id="store" value="&lt;b&gt;Coordination store&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;own SQLite file · single writer · compare-and-set · per-run sequence · compaction&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D4D4CF;align=center;spacingLeft=14;spacingRight=14;verticalAlign=middle;fontColor=#1C1C1C;fontSize=13;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1"><mxGeometry x="430" y="470" width="330" height="100" as="geometry"/></mxCell><mxCell id="sched" value="&lt;b&gt;Scheduler&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;machine-wide compute budget · applies the priority policy (no judgement) · visible queue · waiting steps give compute back&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5FFE6;strokeColor=#84CC16;strokeWidth=2;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;fontColor=#1C1C1C;fontSize=13;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1"><mxGeometry x="60" y="470" width="330" height="100" as="geometry"/></mxCell><mxCell id="mon" value="&lt;b&gt;Resource monitor&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;heavy jobs per process tree (cargo, Playwright) · CPU, memory, free disk, load&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D4D4CF;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;fontColor=#1C1C1C;fontSize=13;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1"><mxGeometry x="60" y="610" width="330" height="80" as="geometry"/></mxCell><mxCell id="wcm" value="&lt;b&gt;Working-copy manager&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;worktree per run · shared build cache · verified hand-over (branch, commit, clean) · external leases · nxf/nxm/nxc resolve to the main workspace&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D4D4CF;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;fontColor=#1C1C1C;fontSize=13;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1"><mxGeometry x="800" y="470" width="350" height="110" as="geometry"/></mxCell><mxCell id="runtime" value="&lt;b&gt;Session runtime&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;start spec in, facts out (heartbeat, replied, ended, usage, refusals) · decides nothing&lt;br&gt;adapters: Claude Agent SDK · Codex · Gemini CLI · Kiro CLI · local models&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5FFE6;strokeColor=#84CC16;strokeWidth=2;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;fontColor=#1C1C1C;fontSize=13;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1"><mxGeometry x="430" y="620" width="330" height="120" as="geometry"/></mxCell><mxCell id="sessions" value="&lt;b&gt;Agent sessions&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;work in their worktree · may open side threads to callable personas · answers return to the asker&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D4D4CF;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;fontColor=#1C1C1C;fontSize=13;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1"><mxGeometry x="430" y="790" width="330" height="80" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;db.sqlite (synced)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;chat model (messages, threads) · nxf board · nxm memory&lt;/font&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D4D4CF;align=center;spacingLeft=14;spacingRight=14;verticalAlign=middle;fontColor=#1C1C1C;fontSize=13;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1"><mxGeometry x="800" y="630" width="350" height="100" as="geometry"/></mxCell><mxCell id="sync" value="&lt;b&gt;Sync (nxs) — extended for nxc&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;ops + run events, status, notifications · ordered and gap-free · signed commissions · target machine, exactly-once on wake · machine liveness and health · opt-in evidence&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5FFE6;strokeColor=#84CC16;strokeWidth=2;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;fontColor=#1C1C1C;fontSize=13;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1"><mxGeometry x="800" y="780" width="350" height="120" as="geometry"/></mxCell><mxCell id="note_dev" value="The machine executes only commissions signed by a person or delegation it trusts. Local agents work offline: delegations are verified on the machine; tokens are needed only at the network boundary." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#6B6B6B;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1"><mxGeometry x="60" y="920" width="700" height="50" as="geometry"/></mxCell><mxCell id="relay" value="&lt;b&gt;Relay&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;signed op streams per workspace / person · per-stream authorisation · auth log and delegation ops (a0y8) · snapshots&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D4D4CF;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;fontColor=#1C1C1C;fontSize=13;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1"><mxGeometry x="1230" y="640" width="260" height="120" as="geometry"/></mxCell><mxCell id="g_mf" value="manufakt.io (web + iPhone) — experiences on top of the contracts" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7A9CC6;dashed=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontColor=#1C1C1C;fontSize=16;fontStyle=1;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1"><mxGeometry x="1230" y="110" width="560" height="470" as="geometry"/></mxCell><mxCell id="cockpit" value="&lt;b&gt;Remote cockpit&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;run as a sequence of steps · sessions · evidence · machine health · commission from the phone&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F7FB;strokeColor=#7A9CC6;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;fontColor=#1C1C1C;fontSize=13;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1"><mxGeometry x="1260" y="160" width="500" height="90" as="geometry"/></mxCell><mxCell id="policy" value="&lt;b&gt;Priority policy (Head of Product)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;ranked, explicit priorities with reasons · owner overrides · sets order, never approvals&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F7FB;strokeColor=#7A9CC6;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;fontColor=#1C1C1C;fontSize=13;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1"><mxGeometry x="1260" y="280" width="500" height="90" as="geometry"/></mxCell><mxCell id="reach" value="&lt;b&gt;Reaching the owner&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;push notifications · escalation and approval UI · gate answers signed with the person's identity&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F7FB;strokeColor=#7A9CC6;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;fontColor=#1C1C1C;fontSize=13;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1"><mxGeometry x="1260" y="400" width="500" height="90" as="geometry"/></mxCell><mxCell id="g_prod" value="Product server (e.g. nexflow.it helpers)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7A9CC6;dashed=1;verticalAlign=top;align=left;spacingLeft=16;spacingTop=8;fontColor=#1C1C1C;fontSize=16;fontStyle=1;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1"><mxGeometry x="1230" y="800" width="560" height="200" as="geometry"/></mxCell><mxCell id="prod" value="&lt;b&gt;Same run engine, product profile&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;short bounded steps · storage trait → the product's backend · external timers · session runtime on a platform-chosen host · coalesced event triggers · no scheduler, no worktrees&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F7FB;strokeColor=#7A9CC6;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;fontColor=#1C1C1C;fontSize=13;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1"><mxGeometry x="1260" y="850" width="500" height="120" as="geometry"/></mxCell><mxCell id="ident" value="&lt;b&gt;Identity broker&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;delegation per agent (a0y8) · scoped, revocable · short-lived tokens at the network boundary&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F4F7FB;strokeColor=#7A9CC6;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;fontColor=#1C1C1C;fontSize=13;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1"><mxGeometry x="1530" y="640" width="260" height="120" as="geometry"/></mxCell><mxCell id="e1" value="append event" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#65A30D;strokeWidth=2;fontSize=11;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" parent="1" source="surf" target="inbox" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="in order" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#65A30D;strokeWidth=2;fontSize=11;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="inbox" target="engine" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="persist (CAS)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#65A30D;strokeWidth=2;fontSize=11;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="engine" target="store" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="state changed" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#65A30D;strokeWidth=2;fontSize=11;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" parent="1" source="engine" target="status" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="subscribe / read" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#6B6B6B;fontSize=11;fontColor=#4A4A4A;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" parent="1" source="status" target="surf" edge="1"><mxGeometry relative="1" as="geometry" x="0.55"><Array as="points"><mxPoint x="975" y="272"/><mxPoint x="324" y="27