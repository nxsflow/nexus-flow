                <mxCell id="note_dev" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#6B6B6B;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" value="The machine executes only commissions signed by a person or delegation it trusts. Local agents work offline: delegations are verified on the machine; tokens are needed only at the network boundary." vertex="1">
                    <mxGeometry height="50" width="700" x="60" y="920" as="geometry"/>
                </mxCell>
                <mxCell id="relay" parent="1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D4D4CF;align=left;spacingLeft=14;spacingRight=14;verticalAlign=middle;fontColor=#1C1C1C;fontSize=13;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" value="&lt;b&gt;Relay&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;signed op streams per workspace / person · per-stream authorisation · auth log and delegation ops (a0y8) · snapshots&lt;/font&gt;" vertex="1">
