<mxfile host="65bd71144e">
    <diagram id="one-op-journey" name="nexus-flow — The journey of one operation">
        <mxGraphModel dx="1123" dy="460" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="1109" background="#FFFFFF" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="The journey of one operation" style="text;html=1;align=left;verticalAlign=middle;fontSize=31;fontStyle=1;fontColor=#1C1C1C;fontFamily=Merriweather;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%3A700%2C900;" parent="1" vertex="1">
                    <mxGeometry x="42" y="46" width="760" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="scene" value="&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;The scene.&lt;/b&gt; &lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #F5FFE6; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;bl0k&lt;/span&gt; is a ticket you just finished; &lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #F5FFE6; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;fr33&lt;/span&gt; is waiting for it. You close &lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #F5FFE6; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;bl0k&lt;/span&gt; — and &lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #F5FFE6; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;fr33&lt;/span&gt; becomes the next thing to do, without anyone writing that down.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingRight=20;fontColor=#6B6B6B;fontSize=14;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1">
                    <mxGeometry x="42" y="100" width="760" height="46" as="geometry"/>
                </mxCell>
                <mxCell id="b1" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;You close one ticket&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 14px;&quot;&gt;&lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #F5FFE6; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;nxf close bl0k&lt;/span&gt; — the CLI calls &lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #F5FFE6; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;Engine::close(…)&lt;/span&gt; in &lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #F5FFE6; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;crates/facade&lt;/span&gt;, the same seam an embedding app calls.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;spacingLeft=20;spacingRight=20;verticalAlign=middle;fontColor=#1C1C1C;fontSize=14;fillColor=#FFFFFF;strokeColor=#E5E5E0;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1">
                    <mxGeometry x="42" y="202" width="760" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="b1band" value="&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;surface&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1">
                    <mxGeometry x="814" y="202" width="140" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="b2" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;The log grows by three rows&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 14px;&quot;&gt;Three appends, no edit — the row that said &lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #FFFFFF; border: 1px solid #DCEFC0; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;in_progress&lt;/span&gt; is still there:&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family: JetBrains Mono, monospace; font-size: 13px; color: #1C1C1C; background-color: #FFFFFF; border: 1px solid #DCEFC0; border-radius: 3px; padding: 8px 10px; display: inline-block&quot;&gt;&lt;span style=&quot;color: #6B6B6B&quot;&gt;12&amp;#160;&amp;#160;&amp;#160;&amp;#160;bl0k&amp;#160;&amp;#160;&amp;#160;status&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;in_progress&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#8592; still there&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color: #DCF0B8&quot;&gt;&lt;b&gt;13&amp;#160;&amp;#160;&amp;#160;&amp;#160;bl0k&amp;#160;&amp;#160;&amp;#160;status&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;closed&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color: #DCF0B8&quot;&gt;&lt;b&gt;14&amp;#160;&amp;#160;&amp;#160;&amp;#160;bl0k&amp;#160;&amp;#160;&amp;#160;closing_comment&amp;#160;&amp;#160;shipped in #412&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color: #DCF0B8&quot;&gt;&lt;b&gt;15&amp;#160;&amp;#160;&amp;#160;&amp;#160;bl0k&amp;#160;&amp;#160;&amp;#160;closed_at&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;2026-09-02T09:14Z&lt;/b&gt;&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;spacingLeft=20;spacingRight=20;verticalAlign=middle;fontColor=#1C1C1C;fontSize=14;fillColor=#F5FFE6;strokeColor=#84CC16;strokeWidth=2;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1">
                    <mxGeometry x="42" y="342" width="760" height="205" as="geometry"/>
                </mxCell>
                <mxCell id="b2band" value="&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;substrate&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1">
                    <mxGeometry x="814" y="342" width="140" height="205" as="geometry"/>
                </mxCell>
                <mxCell id="b3" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;The views are refolded&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 14px;&quot;&gt;A reducer folds the new ops into the &lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #FFFFFF; border: 1px solid #DCEFC0; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;items&lt;/span&gt; view. The view is a cache of the log, never a second truth.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;spacingLeft=20;spacingRight=20;verticalAlign=middle;fontColor=#1C1C1C;fontSize=14;fillColor=#F5FFE6;strokeColor=#84CC16;strokeWidth=2;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1">
                    <mxGeometry x="42" y="603" width="760" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="b3band" value="&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;substrate&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1">
                    <mxGeometry x="814" y="603" width="140" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="b4" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;The answer changes&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 14px;&quot;&gt;Same two commands, before and after — and nothing was written to &lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #F5FFE6; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;fr33&lt;/span&gt;:&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family: JetBrains Mono, monospace; font-size: 13px; color: #1C1C1C; background-color: #F5FFE6; border: 1px solid #DCEFC0; border-radius: 3px; padding: 8px 10px; display: inline-block&quot;&gt;&lt;b&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;before&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;after&lt;/b&gt;&lt;br&gt;nxf next&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;bl0k&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;b&gt;fr33&lt;/b&gt;&lt;br&gt;nxf blocked&amp;#160;&amp;#160;&amp;#160;&amp;#160;fr33&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;b&gt;&amp;#8212; nothing &amp;#8212;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;spacingLeft=20;spacingRight=20;verticalAlign=middle;fontColor=#1C1C1C;fontSize=14;fillColor=#FFFFFF;strokeColor=#E5E5E0;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1">
                    <mxGeometry x="42" y="743" width="760" height="172" as="geometry"/>
                </mxCell>
                <mxCell id="b4band" value="&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;derivation&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1">
                    <mxGeometry x="814" y="743" width="140" height="172" as="geometry"/>
                </mxCell>
                <mxCell id="e0" value="appends, never edits" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#84CC16;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;fontColor=#6B6B6B;labelBackgroundColor=#FFFFFF;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" source="b1" target="b2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e1" value="folded in" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#84CC16;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;fontColor=#6B6B6B;labelBackgroundColor=#FFFFFF;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" source="b2" target="b3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" value="read fresh, not stored" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#6B6B6B;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;fontColor=#6B6B6B;labelBackgroundColor=#FFFFFF;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" source="b3" target="b4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="callout" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;No row anywhere says which item comes next.&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 14px;&quot;&gt;&lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #FFFFFF; border: 1px solid #DCEFC0; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;nxf next&lt;/span&gt; and &lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #FFFFFF; border: 1px solid #DCEFC0; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;nxf blocked&lt;/span&gt; are questions, asked fresh each time — not columns that someone keeps up to date.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;spacingLeft=20;spacingRight=20;verticalAlign=middle;fontColor=#1C1C1C;fontSize=14;fillColor=#F5FFE6;strokeColor=#84CC16;strokeWidth=2;dashed=1;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1">
                    <mxGeometry x="42" y="971" width="760" height="92" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
