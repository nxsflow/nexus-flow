<mxfile host="65bd71144e">
    <diagram id="one-op-journey" name="nexus-flow — The journey of one operation">
        <mxGraphModel dx="1123" dy="460" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="2076" background="#FFFFFF" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="The journey of one operation" style="text;html=1;align=left;verticalAlign=middle;fontSize=31;fontStyle=1;fontColor=#1C1C1C;fontFamily=Merriweather;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%3A700%2C900;" parent="1" vertex="1">
                    <mxGeometry x="42" y="46" width="760" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="scene" value="&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;The scene.&lt;/b&gt; Two items on the board: &lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; background-color: rgb(245, 255, 230); color: rgb(28, 28, 28); border-radius: 3px; padding: 0px 3px;&quot;&gt;bl0k&lt;/span&gt; is a ticket you just finished which the ticket&amp;nbsp;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; background-color: rgb(245, 255, 230); color: rgb(28, 28, 28); border-radius: 3px; padding: 0px 3px;&quot;&gt;fr33&lt;/span&gt;&amp;nbsp;is waiting for. You close &lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; background-color: rgb(245, 255, 230); color: rgb(28, 28, 28); border-radius: 3px; padding: 0px 3px;&quot;&gt;bl0k&lt;/span&gt;. Nothing touches &lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; background-color: rgb(245, 255, 230); color: rgb(28, 28, 28); border-radius: 3px; padding: 0px 3px;&quot;&gt;fr33&lt;/span&gt; — and yet &lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; background-color: rgb(245, 255, 230); color: rgb(28, 28, 28); border-radius: 3px; padding: 0px 3px;&quot;&gt;nxf next&lt;/span&gt; starts offering it. Everything below is what happens in between.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingRight=20;fontColor=#6B6B6B;fontSize=14;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" vertex="1" parent="1">
                    <mxGeometry x="42" y="100" width="760" height="64" as="geometry"/>
                </mxCell>
                <mxCell id="b1" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;The verb&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 14px;&quot;&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; background-color: rgb(245, 255, 230); color: rgb(28, 28, 28); border-radius: 3px; padding: 0px 3px;&quot;&gt;nxf close bl0k --reason &quot;shipped in #412&quot;&lt;/span&gt;&amp;nbsp;&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;spacingLeft=20;spacingRight=20;verticalAlign=middle;fontColor=#1C1C1C;fontSize=14;fillColor=#FFFFFF;strokeColor=#E5E5E0;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1">
                    <mxGeometry x="42" y="212" width="760" height="84" as="geometry"/>
                </mxCell>
                <mxCell id="b1band" value="&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;surface&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1">
                    <mxGeometry x="814" y="220" width="140" height="76" as="geometry"/>
                </mxCell>
                <mxCell id="b2" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;The seam&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 14px;&quot;&gt;&lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #F5FFE6; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;Engine::close(now, actor, id, reason)&lt;/span&gt; in &lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #F5FFE6; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;crates/facade&lt;/span&gt; — the SAME call an embedding app makes. No private path the CLI can take and an app cannot.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;spacingLeft=20;spacingRight=20;verticalAlign=middle;fontColor=#1C1C1C;fontSize=14;fillColor=#FFFFFF;strokeColor=#84CC16;strokeWidth=2;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1">
                    <mxGeometry x="42" y="342" width="760" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="b2band" value="&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;engine seam&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1">
                    <mxGeometry x="814" y="352" width="140" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="b3" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;One verb, three ops&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 14px;&quot;&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; background-color: rgb(245, 255, 230); color: rgb(28, 28, 28); border-radius: 3px; padding: 0px 3px;&quot;&gt;write::close&lt;/span&gt; appends operations to the log: &lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; background-color: rgb(245, 255, 230); color: rgb(28, 28, 28); border-radius: 3px; padding: 0px 3px;&quot;&gt;set_field(status)&lt;/span&gt;, &lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; background-color: rgb(245, 255, 230); color: rgb(28, 28, 28); border-radius: 3px; padding: 0px 3px;&quot;&gt;set_field(closing_comment)&lt;/span&gt;, &lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; background-color: rgb(245, 255, 230); color: rgb(28, 28, 28); border-radius: 3px; padding: 0px 3px;&quot;&gt;set_field(closed_at)&lt;/span&gt; — each stamped with the field&#39;s declared merge strategy.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;spacingLeft=20;spacingRight=20;verticalAlign=middle;fontColor=#1C1C1C;fontSize=14;fillColor=#FFFFFF;strokeColor=#E5E5E0;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1">
                    <mxGeometry x="42" y="504" width="760" height="104" as="geometry"/>
                </mxCell>
                <mxCell id="b3band" value="&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;engine&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1">
                    <mxGeometry x="814" y="498" width="140" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="b4" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;The log — three rows longer&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 14px;&quot;&gt;Every verb before this one is still here, grouped by the command that appended it — and note that a verb is not one row: &lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; background-color: rgb(255, 255, 255); border: 1px solid rgb(220, 239, 192); color: rgb(28, 28, 28); border-radius: 3px; padding: 0px 3px;&quot;&gt;create&lt;/span&gt; appends five. The highlighted rows are what &lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; background-color: rgb(255, 255, 255); border: 1px solid rgb(220, 239, 192); color: rgb(28, 28, 28); border-radius: 3px; padding: 0px 3px;&quot;&gt;close&lt;/span&gt; just added.&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; font-size: 12px; color: rgb(28, 28, 28); background-color: rgb(255, 255, 255); border: 1px solid rgb(220, 239, 192); border-radius: 3px; padding: 6px 8px; display: inline-block;&quot;&gt;&lt;b&gt;lamport&amp;nbsp;&amp;nbsp;kind&amp;nbsp;&amp;nbsp;target&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;field&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;value&lt;/b&gt;&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;span style=&quot;color: rgb(132, 204, 22);&quot;&gt;&lt;b&gt;nxf create --type feature --title &quot;Ship the export path&quot; \&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(132, 204, 22);&quot;&gt;&lt;b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;--description &quot;The CSV path in the exporter&quot; --priority P2&lt;/b&gt;&lt;/span&gt;&lt;br&gt;1&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;item&amp;nbsp;&amp;nbsp;bl0k&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;type&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;feature&lt;br&gt;2&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;item&amp;nbsp;&amp;nbsp;bl0k&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;title&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Ship the export path&lt;br&gt;3&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;item&amp;nbsp;&amp;nbsp;bl0k&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;status&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;open&lt;br&gt;4&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;item&amp;nbsp;&amp;nbsp;bl0k&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;description&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;The CSV path in the exporter&lt;br&gt;5&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;item&amp;nbsp;&amp;nbsp;bl0k&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;priority&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;2&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;span style=&quot;color: rgb(132, 204, 22);&quot;&gt;&lt;b&gt;nxf create --type feature --title &quot;Publish the diagram&quot; \&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(132, 204, 22);&quot;&gt;&lt;b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;--description &quot;Ship the architecture picture&quot; --priority P2&lt;/b&gt;&lt;/span&gt;&lt;br&gt;6&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;item&amp;nbsp;&amp;nbsp;fr33&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;type&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;feature&lt;br&gt;7&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;item&amp;nbsp;&amp;nbsp;fr33&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;title&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Publish the diagram&lt;br&gt;8&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;item&amp;nbsp;&amp;nbsp;fr33&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;status&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;open&lt;br&gt;9&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;item&amp;nbsp;&amp;nbsp;fr33&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;description&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Ship the architecture picture&lt;br&gt;10&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;item&amp;nbsp;&amp;nbsp;fr33&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;priority&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;2&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;span style=&quot;color: rgb(132, 204, 22);&quot;&gt;&lt;b&gt;nxf dep add fr33 bl0k&lt;/b&gt;&lt;/span&gt;&lt;br&gt;11&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;edge&amp;nbsp;&amp;nbsp;fr33→bl0k&amp;nbsp;&amp;nbsp;present&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;add&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;span style=&quot;color: rgb(132, 204, 22);&quot;&gt;&lt;b&gt;nxf claim bl0k&lt;/b&gt;&lt;/span&gt;&lt;br&gt;12&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;item&amp;nbsp;&amp;nbsp;bl0k&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;status&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;in_progress&lt;br&gt;&amp;nbsp;&lt;br&gt;&lt;span style=&quot;color: rgb(132, 204, 22);&quot;&gt;&lt;b&gt;nxf close bl0k --reason &quot;shipped in #412&quot;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color: rgb(220, 240, 184);&quot;&gt;&lt;b&gt;13&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;item&amp;nbsp;&amp;nbsp;bl0k&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;status&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;closed&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color: rgb(220, 240, 184);&quot;&gt;&lt;b&gt;14&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;item&amp;nbsp;&amp;nbsp;bl0k&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;closing_comment&amp;nbsp;&amp;nbsp;&amp;nbsp;shipped in #412&amp;nbsp; &amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color: rgb(220, 240, 184);&quot;&gt;&lt;b&gt;15&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;item&amp;nbsp;&amp;nbsp;bl0k&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;closed_at&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;2026-09-02T09:14Z&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;br&gt;Nothing was ever overwritten: row 12 still says &lt;span style=&quot;font-family: &amp;quot;JetBrains Mono&amp;quot;, monospace; background-color: rgb(255, 255, 255); border: 1px solid rgb(220, 239, 192); color: rgb(28, 28, 28); border-radius: 3px; padding: 0px 3px;&quot;&gt;in_progress&lt;/span&gt;, we keep the history.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;spacingLeft=20;spacingRight=20;verticalAlign=middle;fontColor=#1C1C1C;fontSize=14;fillColor=#F5FFE6;strokeColor=#84CC16;strokeWidth=2;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1">
                    <mxGeometry x="42" y="675" width="760" height="580" as="geometry"/>
                </mxCell>
                <mxCell id="b4band" value="&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;substrate&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1">
                    <mxGeometry x="814" y="664" width="140" height="600" as="geometry"/>
                </mxCell>
                <mxCell id="b5" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;The fold&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 14px;&quot;&gt;A reducer folds each op into the &lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #FFFFFF; border: 1px solid #DCEFC0; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;items&lt;/span&gt; view under keep-if-beats LWW. The view is a CACHE of the log — delete it and a refold rebuilds it.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;spacingLeft=20;spacingRight=20;verticalAlign=middle;fontColor=#1C1C1C;fontSize=14;fillColor=#F5FFE6;strokeColor=#84CC16;strokeWidth=2;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1">
                    <mxGeometry x="42" y="1320" width="760" height="103" as="geometry"/>
                </mxCell>
                <mxCell id="b5band" value="&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;substrate&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1">
                    <mxGeometry x="814" y="1320" width="140" height="96" as="geometry"/>
                </mxCell>
                <mxCell id="b6" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;The answer changes&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 14px;&quot;&gt;Two lanes, before and after — the same two commands, run twice:&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family: JetBrains Mono, monospace; font-size: 12px; color: #1C1C1C; background-color: #F5FFE6; border: 1px solid #DCEFC0; border-radius: 3px; padding: 6px 8px; display: inline-block&quot;&gt;&lt;span style=&quot;color: #84CC16&quot;&gt;&lt;b&gt;$ nxf next&lt;/b&gt;&lt;/span&gt;&lt;br&gt;showing 1 of 1&lt;br&gt;bl0k&amp;#160;&amp;#160;P2&amp;#160;&amp;#160;in progress&amp;#160;&amp;#160;[feature]&amp;#160;&amp;#160;Ship the export path&lt;br&gt;&amp;#160;&lt;br&gt;&lt;span style=&quot;color: #84CC16&quot;&gt;&lt;b&gt;$ nxf blocked&lt;/b&gt;&lt;/span&gt;&lt;br&gt;fr33&amp;#160;&amp;#160;P2&amp;#160;&amp;#160;open&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;[feature]&amp;#160;&amp;#160;Publish the diagram&lt;br&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;↳ blocked by: bl0k (in progress)&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family: JetBrains Mono, monospace; font-size: 12px; color: #1C1C1C; background-color: #F5FFE6; border: 1px solid #DCEFC0; border-radius: 3px; padding: 6px 8px; display: inline-block&quot;&gt;&lt;span style=&quot;color: #84CC16&quot;&gt;&lt;b&gt;$ nxf next&lt;/b&gt;&lt;/span&gt;&lt;br&gt;showing 1 of 1&lt;br&gt;&lt;b&gt;fr33&amp;#160;&amp;#160;P2&amp;#160;&amp;#160;open&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;[feature]&amp;#160;&amp;#160;Publish the diagram&lt;/b&gt;&lt;br&gt;&amp;#160;&lt;br&gt;&lt;span style=&quot;color: #84CC16&quot;&gt;&lt;b&gt;$ nxf blocked&lt;/b&gt;&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;br&gt;The second &lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #F5FFE6; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;nxf blocked&lt;/span&gt; prints NOTHING: the lane is empty, so there is no line to show. Between the two runs there was nothing but the three appended rows — &lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #F5FFE6; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;blocked_gating&lt;/span&gt; holds an item back only while a dep is not yet closed, so &lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #F5FFE6; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;fr33&lt;/span&gt; stops matching. The PREDICATE ran again; nothing wrote to it.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;spacingLeft=20;spacingRight=20;verticalAlign=middle;fontColor=#1C1C1C;fontSize=14;fillColor=#FFFFFF;strokeColor=#E5E5E0;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1">
                    <mxGeometry x="42" y="1490" width="760" height="380" as="geometry"/>
                </mxCell>
                <mxCell id="b6band" value="&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 12px;&quot;&gt;derivation&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1">
                    <mxGeometry x="814" y="1490" width="140" height="380" as="geometry"/>
                </mxCell>
                <mxCell id="e0" value="calls" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#6B6B6B;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;fontColor=#6B6B6B;labelBackgroundColor=#FFFFFF;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" source="b1" target="b2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e1" value="appends" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#6B6B6B;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;fontColor=#6B6B6B;labelBackgroundColor=#FFFFFF;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" source="b2" target="b3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e2" value="one row each" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#84CC16;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;fontColor=#6B6B6B;labelBackgroundColor=#FFFFFF;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" source="b3" target="b4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e3" value="folded in" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#84CC16;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;fontColor=#6B6B6B;labelBackgroundColor=#FFFFFF;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" source="b4" target="b5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e4" value="read, not stored" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#6B6B6B;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;fontColor=#6B6B6B;labelBackgroundColor=#FFFFFF;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" source="b5" target="b6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="callout" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;No row anywhere says which item comes next.&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 14px;&quot;&gt;Search the schema and there is no such column. &lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #FFFFFF; border: 1px solid #DCEFC0; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;nxf next&lt;/span&gt; and &lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #FFFFFF; border: 1px solid #DCEFC0; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;nxf blocked&lt;/span&gt; are QUESTIONS, asked fresh each time — which is why no ordering of two machines’ writes can leave the board disagreeing with itself.&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;align=left;spacingLeft=20;spacingRight=20;verticalAlign=middle;fontColor=#1C1C1C;fontSize=14;fillColor=#F5FFE6;strokeColor=#84CC16;strokeWidth=2;dashed=1;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1">
                    <mxGeometry x="42" y="1926" width="760" height="104" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>