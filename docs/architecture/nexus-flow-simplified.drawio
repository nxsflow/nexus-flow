<mxfile host="65bd71144e">
    <diagram id="nxs-simplified" name="nexus-flow — High Level (simplified)">
        <mxGraphModel dx="2547" dy="1227" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="1100" background="#FFFFFF" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="title" value="nexus-flow — Architecture at a glance" style="text;html=1;align=left;verticalAlign=middle;fontSize=31;fontStyle=1;fontColor=#1C1C1C;fontFamily=Merriweather;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%3A700%2C900;" parent="1" vertex="1">
                    <mxGeometry x="42" y="46" width="760" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="P1" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;1 · Who talks to the system&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 14px;&quot;&gt;coding agents (one SessionStart hook per active block) · humans at the terminal · MCP hosts · embedding apps (manufakt.io, nexflow.it)&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E5E5E0;align=left;spacingLeft=20;spacingRight=20;verticalAlign=middle;fontColor=#1C1C1C;fontSize=14;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1">
                    <mxGeometry x="42" y="136" width="760" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="P2" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;2 · Surfaces&lt;/b&gt; — what you can &lt;i&gt;talk to&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 14px;&quot;&gt;ONE binary, four personas dispatched by &lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #F5FFE6; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;argv[0]&lt;/span&gt;: &lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #F5FFE6; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;nxs&lt;/span&gt; (init · prime · doctor · status · sync · self-update · mcp serve), &lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #F5FFE6; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;nxf&lt;/span&gt;, &lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #F5FFE6; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;nxm&lt;/span&gt;, &lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #F5FFE6; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;nxc&lt;/span&gt; — thin callers with no model of their own&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E5E5E0;align=left;spacingLeft=20;spacingRight=20;verticalAlign=middle;fontColor=#1C1C1C;fontSize=14;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1">
                    <mxGeometry x="42" y="276" width="760" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="P3" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;3 · Engines&lt;/b&gt; — what &lt;i&gt;holds the model&lt;/i&gt;&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 14px;&quot;&gt;flow · memory · chat, each behind its own &lt;b&gt;engine seam&lt;/b&gt; — only flow&#39;s (&lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #F5FFE6; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;crates/facade&lt;/span&gt;) is SemVer-gated. Plugins register here at compile time.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#84CC16;align=left;spacingLeft=20;spacingRight=20;verticalAlign=middle;fontColor=#1C1C1C;fontSize=14;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1">
                    <mxGeometry x="42" y="426" width="760" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="P4" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;4 · Substrate&lt;/b&gt; — ONE workspace, ONE op-log&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 14px;&quot;&gt;&lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #FFFFFF; color: #1C1C1C; border: 1px solid #DCEFC0; border-radius: 3px; padding: 0px 3px&quot;&gt;.nxs/db.sqlite&lt;/span&gt;, git-ignored and device-local: an append-only &lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #FFFFFF; color: #1C1C1C; border: 1px solid #DCEFC0; border-radius: 3px; padding: 0px 3px&quot;&gt;ops&lt;/span&gt; log as the single source of truth, folded into materialized views per module. ready / blocked / next are derived in SQL, never stored.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F5FFE6;strokeColor=#84CC16;strokeWidth=2;align=left;spacingLeft=20;spacingRight=20;verticalAlign=middle;fontColor=#1C1C1C;fontSize=14;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1">
                    <mxGeometry x="42" y="576" width="760" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="P5" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;5 · The outward edge&lt;/b&gt; — sync, offline-first&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 14px;&quot;&gt;an anti-entropy client, driven by a background service, pushes local ops to &lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #F5FFE6; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;nxf-relay&lt;/span&gt; — a dumb, durable op carrier on SQLite or Postgres — where other replicas converge over the same stream.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E5E5E0;align=left;spacingLeft=20;spacingRight=20;verticalAlign=middle;fontColor=#1C1C1C;fontSize=14;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" vertex="1">
                    <mxGeometry x="42" y="736" width="760" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="P6" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Cross-cutting&lt;/b&gt; — carries all five&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#6B6B6B&quot; style=&quot;font-size: 14px;&quot;&gt;The guides live in &lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #F5FFE6; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;nxs-guide&lt;/span&gt;: compiled into the binaries &lt;i&gt;and&lt;/i&gt; published to nxsflow.com from &lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #F5FFE6; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;content/&lt;/span&gt; — one source, two surfaces (the website renders them in another repo).&lt;br&gt;Plus the shared plumbing: module self-registration (&lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #F5FFE6; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;nxs-init&lt;/span&gt;), presentation (&lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #F5FFE6; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;nxs-ui&lt;/span&gt;), and the drift and parity gates (&lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #F5FFE6; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;xtask&lt;/span&gt;, &lt;span style=&quot;font-family: JetBrains Mono, monospace; background-color: #F5FFE6; color: #1C1C1C; border-radius: 3px; padding: 0px 3px&quot;&gt;nxs-test-support&lt;/span&gt;).&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E5E5E0;dashed=1;align=left;spacingLeft=20;spacingRight=20;verticalAlign=middle;fontColor=#1C1C1C;fontSize=14;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" vertex="1" parent="1">
                    <mxGeometry x="42" y="916" width="760" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="e12" value="calls" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#6B6B6B;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;fontColor=#6B6B6B;labelBackgroundColor=#FFFFFF;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" source="P1" target="P2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e23" value="calls" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#6B6B6B;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;fontColor=#6B6B6B;labelBackgroundColor=#FFFFFF;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" source="P2" target="P3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e34" value="every module appends to THE SAME log" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#84CC16;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;fontColor=#6B6B6B;labelBackgroundColor=#FFFFFF;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" source="P3" target="P4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e45" value="ops out / ops in" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#84CC16;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=12;fontColor=#6B6B6B;labelBackgroundColor=#FFFFFF;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" source="P4" target="P5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e13" value="apps link the engine&lt;br&gt;seam directly —&lt;br&gt;never the CLI" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#84CC16;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;fontColor=#6B6B6B;labelBackgroundColor=#FFFFFF;fontFamily=Merriweather Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DMerriweather%2BSans%3A300%2C400%2C700;" parent="1" source="P1" target="P3" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="882" y="186"/>
                            <mxPoint x="882" y="481"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>