{
  "contract": "deny-account-of",
  "version": 1,
  "about": "Which account <h> a stream id belongs to, as the shared deny list judges it (6j6v.dbmd round 4b, review round 4b Integrity 5). <h> is exactly 32 lowercase hex characters. An id belongs to account <h> iff it equals u-<h> or begins with n-<h>- (the trailing hyphen included); every other id is unscoped (null) and no deny item can name it. nxs_fold_ddb::deny::account_of is pinned to this file by its unit tests; foundations run the same file against the ticket authorizer. The authorizer additionally refuses ids outside its own pattern; that refusal is not part of this mapping.",
  "cases": [
    {
      "id": "u-00ff00ff00ff00ff00ff00ff00ff00ff",
      "account": "00ff00ff00ff00ff00ff00ff00ff00ff",
      "why": "u-<h> exactly"
    },
    {
      "id": "n-00ff00ff00ff00ff00ff00ff00ff00ff-1",
      "account": "00ff00ff00ff00ff00ff00ff00ff00ff",
      "why": "n-<h>-<k>"
    },
    {
      "id": "n-00ff00ff00ff00ff00ff00ff00ff00ff-10",
      "account": "00ff00ff00ff00ff00ff00ff00ff00ff",
      "why": "n-<h>-<k>, k of two digits: the same account as n-<h>-1"
    },
    {
      "id": "n-00ff00ff00ff00ff00ff00ff00ff00ff-1-x",
      "account": "00ff00ff00ff00ff00ff00ff00ff00ff",
      "why": "anything after n-<h>- belongs to the account"
    },
    {
      "id": "n-00ff00ff00ff00ff00ff00ff00ff00ff-",
      "account": "00ff00ff00ff00ff00ff00ff00ff00ff",
      "why": "n-<h>- with nothing after the trailing hyphen"
    },
    {
      "id": "n-00ff00ff00ff00ff00ff00ff00ff00ff-team board/#x",
      "account": "00ff00ff00ff00ff00ff00ff00ff00ff",
      "why": "arbitrary text after n-<h>-: still the account (the authorizer's id pattern refuses the id on its own)"
    },
    {
      "id": "n-00ff00ff00ff00ff00ff00ff00ff00ff-999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999999",
      "account": "00ff00ff00ff00ff00ff00ff00ff00ff",
      "why": "an id longer than the authorizer's 128 characters: account_of still names the account (fail closed: deny more, never less)"
    },
    {
      "id": "u-00ff00ff00ff00ff00ff00ff00ff00ff-1",
      "account": null,
      "why": "u-<h> with a suffix is not u-<h>"
    },
